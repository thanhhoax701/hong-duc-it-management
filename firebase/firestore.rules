rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : profileExists()
          ? (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == null
            ? "requester"
            : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)
          : "requester";
    }

    function customerService() {
      return role() in ["cskh", "CSKH", "customer_service", "customer-service"]
        || (profileExists() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["cskh", "CSKH", "customer_service", "customer-service"])
        || (signedIn() && request.auth.token.email.matches("(?i)^cskh([+@._-].*)?$"));
    }

    function department() {
      return profileExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department
        : "";
    }

    function adminOrIt() {
      return !customerService() && (
        role() in ["admin", "it", "Admin", "IT", "IT Admin"]
        || (signedIn() && request.auth.token.email.matches("(?i)^it([+@].*)$"))
      );
    }

    function manager() {
      return role() == "department_manager";
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || adminOrIt());
      allow create, update, delete: if adminOrIt();
    }

    match /tickets/{ticketId} {
      allow create: if !customerService() && (adminOrIt()
        || (role() == "requester" && request.resource.data.createdByUid == request.auth.uid)
        || (manager() && request.resource.data.department == department()));
      allow read: if !customerService() && (adminOrIt()
        || (resource.data.createdByUid == request.auth.uid)
        || (manager() && resource.data.department == department()));
      allow update: if !customerService() && (adminOrIt()
        || (resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.step == resource.data.step
          && request.resource.data.status == resource.data.status)
        || (manager() && resource.data.department == department()
          && request.resource.data.department == resource.data.department));
      allow delete: if !customerService() && adminOrIt();
    }

    match /ticketHistory/{historyId} {
      allow read: if !customerService() && (adminOrIt()
        || (resource.data.createdByUid == request.auth.uid)
        || (manager() && resource.data.department == department()));
      allow create: if !customerService() && adminOrIt();
      allow update, delete: if false;
    }

    match /comments/{commentId} {
      allow read: if signedIn() && !customerService();
      allow create: if signedIn() && !customerService() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if !customerService() && (adminOrIt() || resource.data.authorUid == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if !customerService() && (adminOrIt() || resource.data.recipient == request.auth.token.email);
      allow create: if !customerService() && adminOrIt();
      allow update: if !customerService() && (adminOrIt() || resource.data.recipient == request.auth.token.email);
      allow delete: if !customerService() && adminOrIt();
    }

    match /approvals/{approvalId} {
      allow read: if !customerService() && (adminOrIt() || resource.data.approver == request.auth.token.email);
      allow create: if !customerService() && (adminOrIt() || manager());
      allow update, delete: if false;
    }

    match /assets/{assetId} {
      allow read: if !customerService() && (adminOrIt() || (manager() && resource.data.department == department()));
      allow create, update, delete: if !customerService() && adminOrIt();
    }

    match /maintenance/{maintenanceId} {
      allow read, write: if !customerService() && adminOrIt();
    }

    match /audit/{auditId} {
      allow read: if !customerService() && role() == "admin";
      allow create: if !customerService() && adminOrIt();
      allow update, delete: if false;
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow write: if adminOrIt();
    }

    match /employees/{employeeId} {
      allow read: if signedIn();
      allow write: if adminOrIt();
    }

    match /storeVisits/{visitId} {
      allow read, write: if !customerService() && adminOrIt();
    }
  }
}
