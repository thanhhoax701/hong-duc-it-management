rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : profileExists()
          ? (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == null
            ? "requester"
            : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)
          : "requester";
    }

    function department() {
      return profileExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department
        : "";
    }

    function adminOrIt() {
      return role() in ["admin", "it"];
    }

    function manager() {
      return role() == "department_manager";
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || adminOrIt());
      allow create, update, delete: if adminOrIt();
    }

    match /tickets/{ticketId} {
      allow create: if adminOrIt()
        || (role() == "requester" && request.resource.data.createdByUid == request.auth.uid)
        || (manager() && request.resource.data.department == department());
      allow read: if adminOrIt()
        || (resource.data.createdByUid == request.auth.uid)
        || (manager() && resource.data.department == department());
      allow update: if adminOrIt()
        || (resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.step == resource.data.step
          && request.resource.data.status == resource.data.status)
        || (manager() && resource.data.department == department()
          && request.resource.data.department == resource.data.department);
      allow delete: if adminOrIt();
    }

    match /ticketHistory/{historyId} {
      allow read: if adminOrIt()
        || (resource.data.createdByUid == request.auth.uid)
        || (manager() && resource.data.department == department());
      allow create: if adminOrIt();
      allow update, delete: if false;
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if adminOrIt() || resource.data.authorUid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if adminOrIt() || resource.data.recipient == request.auth.token.email;
      allow create: if adminOrIt();
      allow update: if adminOrIt() || resource.data.recipient == request.auth.token.email;
      allow delete: if adminOrIt();
    }

    match /approvals/{approvalId} {
      allow read: if adminOrIt() || resource.data.approver == request.auth.token.email;
      allow create: if adminOrIt() || manager();
      allow update, delete: if false;
    }

    match /assets/{assetId} {
      allow read: if adminOrIt() || (manager() && resource.data.department == department());
      allow create, update, delete: if adminOrIt();
    }

    match /maintenance/{maintenanceId} {
      allow read, write: if adminOrIt();
    }

    match /audit/{auditId} {
      allow read: if role() == "admin";
      allow create: if adminOrIt();
      allow update, delete: if false;
    }

    match /departments/{departmentId} {
      allow read: if signedIn();
      allow write: if adminOrIt();
    }

    match /employees/{employeeId} {
      allow read: if signedIn();
      allow write: if adminOrIt();
    }

    match /storeVisits/{visitId} {
      allow read, write: if adminOrIt();
    }
  }
}
